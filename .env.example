# Set real values in Netlify > Project configuration > Environment variables.
# Scope: Functions. Never use VITE_, NEXT_PUBLIC_ or put secrets in netlify.toml.
APP_PASSWORD=
SESSION_SECRET=
OPENROUTER_API_KEY=
# Optional independent provider:
GEMINI_API_KEY=
# Optional OpenAI-compatible provider (server-admin controlled only):
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=
COMPATIBLE_MODEL=
COMPATIBLE_VISION=false
# Optional settings:
OPENROUTER_MODELS=openai/gpt-6-luna,google/gemini-2.5-flash-lite
MAX_OUTPUT_TOKENS=16000
